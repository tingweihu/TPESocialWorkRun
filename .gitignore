# Only the public source, documentation and assets belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/vercel.json
!/data/
/data/*
!/data/*.json
!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/SOURCES.md
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/title.jpg
!/docs/screenshots/landscape.jpg
!/docs/screenshots/portrait.jpg
!/starter/
/starter/*
!/starter/index.html
!/starter/package.json
!/starter/package-lock.json
!/starter/tsconfig.json
!/starter/vite.config.ts
!/starter/tests/
/starter/tests/*
!/starter/tests/*.mjs
!/starter/src/
/starter/src/**
!/starter/src/**/
!/starter/src/**/*.ts
!/starter/src/**/*.css
**/.env
**/.env.*
**/node_modules/
**/dist/
**/*.log
**/.DS_Store
**/Thumbs.db
